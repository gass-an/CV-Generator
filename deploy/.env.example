# =============================================================================
# Application
# =============================================================================

# Version de l'application / des images Docker.
APP_VERSION=v0.1.0

# Environnement d'exécution : development / production
APP_ENV=development

LOG_LEVEL=INFO

# Port HTTP local du frontend Nginx. Vérifier sa disponibilité sur l'hôte.
WEB_PORT=8082

OPT_AVP_BASE_URL=https://opt-nc.github.io/odata-avps


# =============================================================================
# PostgreSQL
# =============================================================================

POSTGRES_DB=cv_generator
POSTGRES_USER=cv_generator
POSTGRES_PASSWORD=

# Port exposé sur l'hôte si nécessaire.
# Principalement utile en développement local.
POSTGRES_PORT=5432

DATABASE_URL="postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}"


# =============================================================================
# llama.cpp
# =============================================================================

# Exemples :
# - Docker Compose : http://llm:8080
# - LLM distant / Tailscale : https://machine.example.ts.net
LLM_BASE_URL=

# Valeur d'initialisation uniquement ; la sélection est ensuite persistée en base.
LLM_MODEL=ggml-org/Qwen3-14B-GGUF:Q4_K_M
LLM_CTX_SIZE=8192
# Couvre aussi le chargement initial en VRAM après un redémarrage du Router.
LLM_TIMEOUT_SECONDS=600
LLM_MANAGEMENT_ENABLED=false
LLM_MANAGEMENT_TIMEOUT_SECONDS=30
LLM_ACTIVATION_TIMEOUT_SECONDS=600


# =============================================================================
# Worker
# =============================================================================

WORKER_POLL_INTERVAL_SECONDS=1
WORKER_STALE_JOB_TIMEOUT_SECONDS=600


# =============================================================================
# Conversion PDF
# =============================================================================

LIBREOFFICE_EXECUTABLE=libreoffice
PDF_CONVERSION_TIMEOUT_SECONDS=60
PDF_CONVERSION_MAX_CONCURRENT=2


# =============================================================================
# Administration
# =============================================================================

ADMIN_USERNAME=

# Générer un véritable hash Argon2 pour l'environnement cible.
# Ne jamais versionner un véritable secret.
# Les apostrophes simples conservent littéralement les caractères $.
ADMIN_PASSWORD_HASH='$argon2id$...'

ADMIN_SESSION_SECRET=
ADMIN_SESSION_TTL_SECONDS=3600

ADMIN_SESSION_COOKIE_NAME=cv_generator_admin_session
ADMIN_CSRF_COOKIE_NAME=cv_generator_admin_csrf

# false en HTTP local
# true en production HTTPS
ADMIN_COOKIE_SECURE=false

# Exemples :
# - local : http://127.0.0.1:8001
# - production : https://admin.example.ts.net
ADMIN_BASE_URL=http://127.0.0.1:8001

ADMIN_TIMEZONE=Pacific/Noumea

ADMIN_LOGIN_WINDOW_SECONDS=900
ADMIN_LOGIN_MAX_ATTEMPTS=5

# Liste éventuelle des proxies de confiance.
ADMIN_TRUSTED_PROXY_IPS=
