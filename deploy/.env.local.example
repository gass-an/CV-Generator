# Application
LOG_LEVEL=INFO
OPT_AVP_BASE_URL=https://opt-nc.github.io/odata-avps

# PostgreSQL local
POSTGRES_DB=cv_generator_local
POSTGRES_USER=cv_generator
POSTGRES_PASSWORD=cv_generator
POSTGRES_PORT=5432

# llama.cpp distant
# Renseigner l'URL réelle vérifiée de la tour Windows accessible par Tailscale.
# Ne pas supposer que host.docker.internal désigne cette machine distante.
LLM_BASE_URL=
LLM_MODEL=ggml-org/Qwen3-4B-GGUF:Q4_K_M
LLM_TIMEOUT_SECONDS=120

# Worker facultatif (profil Compose "generation")
WORKER_POLL_INTERVAL_SECONDS=1
WORKER_STALE_JOB_TIMEOUT_SECONDS=600

# Administration locale
ADMIN_USERNAME=
# Ne pas remplacer cet exemple par un véritable secret versionné.
# Les apostrophes simples conservent littéralement les caractères $ et ne sont
# pas transmises au conteneur par Docker Compose.
ADMIN_PASSWORD_HASH='$argon2id$...'
ADMIN_SESSION_SECRET=
ADMIN_SESSION_TTL_SECONDS=3600
ADMIN_SESSION_COOKIE_NAME=cv_generator_admin_session
ADMIN_CSRF_COOKIE_NAME=cv_generator_admin_csrf
ADMIN_COOKIE_SECURE=false
ADMIN_BASE_URL=http://127.0.0.1:8001
ADMIN_TIMEZONE=Pacific/Noumea
ADMIN_LOGIN_WINDOW_SECONDS=900
ADMIN_LOGIN_MAX_ATTEMPTS=5
ADMIN_TRUSTED_PROXY_IPS=
